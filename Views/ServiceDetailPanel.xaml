<UserControl x:Class="BayBrain.Views.ServiceDetailPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:BayBrain.Converters">

    <UserControl.Resources>
        <conv:NullToVisibilityConverter x:Key="NullVis"/>
        <conv:StringNotEmptyConverter   x:Key="StrVis"/>
    </UserControl.Resources>

    <StackPanel>
        <!-- About Card -->
        <Border Background="{StaticResource CardBrush}" CornerRadius="14"
                Padding="16" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="ABOUT THIS SERVICE" Style="{StaticResource TextCaption}" Margin="0,0,0,10"/>

                <TextBlock Text="{Binding SelectedService.DetailedDescription}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="14" TextWrapping="Wrap" LineHeight="22"/>

                <Separator Background="{StaticResource SeparatorBrush}" Margin="0,12"/>

                <!-- Why it matters -->
                <Border Background="{StaticResource Card2Brush}" CornerRadius="10" Padding="12">
                    <StackPanel>
                        <TextBlock Text="💡 WHY IT MATTERS" Style="{StaticResource TextCaption}" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding SelectedService.WhyItMatters}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="13" TextWrapping="Wrap" LineHeight="20"/>
                    </StackPanel>
                </Border>

                <Separator Background="{StaticResource SeparatorBrush}" Margin="0,12"/>

                <!-- Interval + Consequence row -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource Card2Brush}" CornerRadius="10" Padding="12">
                        <StackPanel>
                            <TextBlock Text="⏱ SERVICE INTERVAL" Style="{StaticResource TextCaption}" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding SelectedService.Interval}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="13" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="{StaticResource Card2Brush}" CornerRadius="10" Padding="12">
                        <StackPanel>
                            <TextBlock Text="⚠ IF SKIPPED" Style="{StaticResource TextCaption}" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding SelectedService.SkipConsequence}"
                                       Foreground="{StaticResource OrangeBrush}"
                                       FontSize="13" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Customer Script Generator -->
        <Border Background="{StaticResource CardBrush}" CornerRadius="14" Padding="16">
            <StackPanel>
                <TextBlock Text="CUSTOMER SCRIPT GENERATOR" Style="{StaticResource TextCaption}" Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}"
                             Height="36">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Setter Property="Tag" Value="Customer name or vehicle (e.g. &quot;Mrs. Johnson's Camry&quot;)"/>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>

                <!-- Generated script box -->
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10"
                        Padding="14" Margin="0,0,0,10"
                        Visibility="{Binding GeneratedScript, Converter={StaticResource StrVis}}">
                    <TextBlock Text="{Binding GeneratedScript}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="14" TextWrapping="Wrap" LineHeight="24"
                               FontStyle="Italic"/>
                </Border>

                <Button Content="📋  Copy Script to Clipboard"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding CopyScriptCommand}"
                        HorizontalAlignment="Left"
                        Visibility="{Binding GeneratedScript, Converter={StaticResource StrVis}}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
