<UserControl x:Class="BayBrain.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1000">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" MinWidth="280" MaxWidth="440"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: Search panel -->
        <Border Grid.Column="0" Background="#1C1C1E"
                BorderBrush="#38383A" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="14,14,14,0">
                    <Grid Margin="2,0,0,8">
                        <TextBlock Text="SERVICE SEARCH"
                                   Foreground="#636366" FontSize="10"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <!-- Inline Metrics -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border Background="#2C2C2E" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                <TextBlock FontSize="9" Foreground="#8E8E93">
                                    <Run Text="Results: "/>
                                    <Run Text="{Binding SearchResults.Count, Mode=OneWay}" Foreground="White" FontWeight="Bold"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Search box -->
                    <Grid>
                        <TextBox x:Name="MainSearchBox"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource SearchBoxStyle}" MinHeight="44"/>
                        <TextBlock Text="🔍" FontSize="15"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Margin="14,0,0,0" IsHitTestVisible="False"/>
                        <TextBlock Text="Search services, symptoms, parts…"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Margin="44,0,0,0" Foreground="#636366" FontSize="13"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding SearchQuery, Converter={StaticResource StrVis}, ConverterParameter=invert}"/>
                    </Grid>

                    <!-- Category filter -->
                    <ComboBox Margin="0,8,0,0" Height="36"
                              ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategory}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding}"/></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button Content="✕  Clear" Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding ClearSearchCommand}"
                            HorizontalAlignment="Right" FontSize="11"
                            Padding="8,4" Margin="0,4,0,0"/>

                    <Rectangle Height="1" Fill="#38383A" Margin="0,8,0,0"/>
                </StackPanel>

                <!-- Results list -->
                <ScrollViewer Grid.Row="1" Padding="14,6,14,14" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ServiceGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceBrush}"
                                        CornerRadius="14" Padding="14,12" Margin="0,0,0,14">
                                    <StackPanel>
                                        <!-- Category header -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <TextBlock Text="{Binding Category, Converter={StaticResource CatIcon}}"
                                                       FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Category}"
                                                       FontSize="14" FontWeight="Bold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <Rectangle Height="1" Fill="{StaticResource SeparatorBrush}" Margin="0,0,0,10"/>

                                        <ItemsControl ItemsSource="{Binding Services}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="ServiceCard"
                                                            Background="{StaticResource CardBrush}"
                                                            CornerRadius="10" Padding="12,10"
                                                            Margin="0,0,0,8" Cursor="Hand">
                                                        <Border.InputBindings>
                                                            <MouseBinding MouseAction="LeftClick"
                                                                          Command="{Binding DataContext.SelectServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                          CommandParameter="{Binding}"/>
                                                        </Border.InputBindings>
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Row="0" Grid.Column="0"
                                                                       Text="{Binding Name}"
                                                                       FontSize="14" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                                       TextWrapping="Wrap"/>
                                                            <TextBlock Grid.Row="0" Grid.Column="1"
                                                                       Text="{Binding PriceRange}"
                                                                       FontSize="13" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                                       Margin="8,0,0,0"/>
                                                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                                       Text="{Binding ShortDescription}"
                                                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- RIGHT: Detail panel -->
        <Grid Grid.Column="1">
            <!-- Empty state -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding SelectedService, Converter={StaticResource NullVis}, ConverterParameter=invert}">
                <TextBlock Text="🔍" FontSize="60" HorizontalAlignment="Center"/>
                <TextBlock Text="Select a service to view details"
                           HorizontalAlignment="Center" FontSize="16"
                           Foreground="#8E8E93" Margin="0,16,0,0"/>
                <TextBlock Text="Use the search panel on the left"
                           HorizontalAlignment="Center" FontSize="12"
                           Foreground="#636366" Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Detail panel -->
            <ScrollViewer Padding="28"
                          Visibility="{Binding SelectedService, Converter={StaticResource NullVis}}"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="900">

                    <!-- Header -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedService.Name}"
                                       FontSize="28" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="{Binding SelectedService.Category}"
                                       Foreground="#0A84FF" FontSize="13"
                                       FontWeight="SemiBold" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding SelectedService.PriceRange}"
                                       FontSize="22" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Right"/>
                            <TextBlock HorizontalAlignment="Right"
                                       FontSize="12" Foreground="#8E8E93">
                                <Run Text="{Binding SelectedService.EstimatedMinutes}"/>
                                <Run Text=" min  ·  est. time"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <!-- Urgency card -->
                    <Border Background="#1C1C1E" CornerRadius="16"
                            Padding="18,16" Margin="0,0,0,14"
                            Visibility="{Binding CurrentUrgency, Converter={StaticResource NullVis}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="URGENCY SCORE"
                                           Foreground="#636366" FontSize="10"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Border CornerRadius="8" Padding="12,5"
                                            Background="{Binding CurrentUrgency, Converter={StaticResource UrgencyColor}}">
                                        <TextBlock Text="{Binding CurrentUrgency, Converter={StaticResource UrgencyLabel}}"
                                                   FontSize="11" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center"
                                               Foreground="White" FontSize="22" FontWeight="Bold">
                                        <Run Text="{Binding CurrentUrgency.Score}"/>
                                        <Run Text=" / 10" Foreground="#636366"
                                             FontSize="14" FontWeight="Normal"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                            <Border Background="#2C2C2E" CornerRadius="4" Height="8">
                                <Border CornerRadius="4" Height="8" HorizontalAlignment="Left"
                                        Background="{Binding CurrentUrgency, Converter={StaticResource UrgencyColor}}"
                                        Width="{Binding CurrentUrgency, Converter={StaticResource ScoreBarWidth}}"/>
                            </Border>
                            <TextBlock Text="{Binding CurrentUrgency.Reasoning}"
                                       FontSize="12" Foreground="#8E8E93"
                                       Margin="0,10,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Urgency modifiers -->
                    <Border Background="#1C1C1E" CornerRadius="16"
                            Padding="18,16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="URGENCY MODIFIERS"
                                       Foreground="#636366" FontSize="10"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,14"/>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Miles overdue:"
                                           FontSize="13" Foreground="#8E8E93"
                                           VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBox Text="{Binding MilesOverdue, UpdateSourceTrigger=PropertyChanged}"
                                             Width="70" TextAlignment="Right"
                                             FontSize="13" FontWeight="SemiBold" Foreground="#0A84FF"
                                             VerticalAlignment="Center" Padding="4,2"/>
                                    <TextBlock Text=" mi" FontSize="13" Foreground="#8E8E93" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Slider Minimum="0" Maximum="20000"
                                    Value="{Binding MilesOverdue}"
                                    Foreground="#0A84FF"
                                    Margin="0,0,0,14"/>
                            <CheckBox Content="Customer reports active symptoms"
                                      IsChecked="{Binding HasSymptoms}"
                                      Foreground="White" FontSize="13"/>
                        </StackPanel>
                    </Border>

                    <!-- About card -->
                    <Border Background="#1C1C1E" CornerRadius="16"
                            Padding="18,16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="ABOUT THIS SERVICE"
                                       Foreground="#636366" FontSize="10"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,12"/>
                            <TextBlock Text="{Binding SelectedService.DetailedDescription}"
                                       Foreground="White" FontSize="14"
                                       TextWrapping="Wrap" LineHeight="24"/>
                            <Rectangle Height="1" Fill="#38383A" Margin="0,14"/>
                            <Border Background="#2C2C2E" CornerRadius="12" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="💡  WHY IT MATTERS"
                                               Foreground="#636366" FontSize="10"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding SelectedService.WhyItMatters}"
                                               Foreground="White" FontSize="13"
                                               TextWrapping="Wrap" LineHeight="22"/>
                                </StackPanel>
                            </Border>
                            <Rectangle Height="1" Fill="#38383A" Margin="0,14"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#2C2C2E" CornerRadius="12" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="⏱  INTERVAL"
                                                   Foreground="#636366" FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,8"/>
                                        <TextBlock Text="{Binding SelectedService.Interval}"
                                                   Foreground="White" FontSize="13"
                                                   TextWrapping="Wrap" LineHeight="20"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="#2C2C2E" CornerRadius="12" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="⚠  IF SKIPPED"
                                                   Foreground="#636366" FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,8"/>
                                        <TextBlock Text="{Binding SelectedService.SkipConsequence}"
                                                   Foreground="#FF9500" FontSize="13"
                                                   TextWrapping="Wrap" LineHeight="20"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Script generator card -->
                    <Border Background="#1C1C1E" CornerRadius="16"
                            Padding="18,16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="CUSTOMER SCRIPT GENERATOR"
                                       Foreground="#636366" FontSize="10"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,14"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Customer / Vehicle:"
                                           FontSize="13" Foreground="#8E8E93"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}"
                                         MinHeight="36" FontSize="13"
                                         Background="#2C2C2E" Foreground="White"
                                         BorderBrush="#38383A" BorderThickness="1"
                                         Padding="10,6"/>
                            </Grid>

                            <Border Background="#0D0D0F" CornerRadius="12"
                                    Padding="18" Margin="0,0,0,14"
                                    Visibility="{Binding GeneratedScript, Converter={StaticResource StrVis}}">
                                <TextBlock Text="{Binding GeneratedScript}"
                                           Foreground="#EBEBF5" FontSize="14"
                                           TextWrapping="Wrap" LineHeight="26"
                                           FontStyle="Italic"/>
                            </Border>

                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding GeneratedScript, Converter={StaticResource StrVis}}">
                                <Button Content="📋  Copy"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding CopyScriptCommand}"
                                        Margin="0,0,10,0"/>
                                <Button Content="🖨  Print"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Command="{Binding PrintScriptCommand}"
                                        Margin="0,0,10,0"/>
                                <Button Content="💾  Export HTML"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Command="{Binding ExportScriptCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
