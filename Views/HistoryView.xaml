<UserControl x:Class="BayBrain.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:BayBrain.Converters"
             Background="#1C1C1E">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter         x:Key="BoolVis"/>
        <conv:InverseBoolToVisibilityConverter  x:Key="InvBoolVis"/>
        <conv:HexStringToBrushConverter         x:Key="HexBrush"/>

        <Style x:Key="FilterChip" TargetType="RadioButton">
            <Setter Property="Background"           Value="#2C2C2E"/>
            <Setter Property="Foreground"           Value="#8E8E93"/>
            <Setter Property="BorderThickness"      Value="0"/>
            <Setter Property="Padding"              Value="10,5"/>
            <Setter Property="Cursor"               Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                       FontSize="12"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#0A84FF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HistoryCard" TargetType="Border">
            <Setter Property="Background"    Value="#2C2C2E"/>
            <Setter Property="CornerRadius"  Value="10"/>
            <Setter Property="Padding"       Value="14,12"/>
            <Setter Property="Margin"        Value="0,0,0,8"/>
            <Setter Property="Cursor"        Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Top bar ────────────────────────────────────────────────── -->
        <Border Background="#2C2C2E" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Service History" FontSize="20" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                    <TextBlock FontSize="12" Foreground="#8E8E93" Margin="0,2,0,0">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} records · {1} vehicles · {2} customers">
                                <Binding Path="TotalCount"/>
                                <Binding Path="UniqueVehicles"/>
                                <Binding Path="UniqueCustomers"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>

                <!-- Sort -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="SORT BY" FontSize="10" Foreground="#636366" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding SortOptions}"
                              SelectedItem="{Binding SortBy}"
                              Background="#3A3A3C" Foreground="#FFFFFF" BorderThickness="0"
                              FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Body ───────────────────────────────────────────────────── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Search + List -->
            <Grid Background="#1C1C1E">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Search bar -->
                <Border Background="#2C2C2E" CornerRadius="10" Margin="16,14,16,8" Padding="10,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0" Foreground="#FFFFFF"
                                 FontSize="14" VerticalAlignment="Center"
                                 CaretBrush="#0A84FF">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <VisualBrush Stretch="None" AlignmentX="Left">
                                                        <VisualBrush.Visual>
                                                            <TextBlock Text="Search by customer, vehicle, VIN, advisor…"
                                                                       Foreground="#636366" FontSize="14"/>
                                                        </VisualBrush.Visual>
                                                    </VisualBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <Button Grid.Column="2" Content="✕" Background="Transparent" BorderThickness="0"
                                Foreground="#636366" FontSize="12" Cursor="Hand"
                                Command="{Binding ClearSearchCommand}"
                                Visibility="{Binding HasResults, Converter={StaticResource BoolVis}}"/>
                    </Grid>
                </Border>

                <!-- Category chips -->
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled" Margin="16,0,16,8">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource FilterChip}" Content="All"
                                     IsChecked="{Binding FilterCategory, Converter={StaticResource BoolVis}}"
                                     Margin="0,0,6,0" GroupName="HistCat"
                                     Command="{Binding DataContext.SetCategoryCommand,
                                         RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     CommandParameter="All"/>
                        <ItemsControl ItemsSource="{Binding CategoryFilters}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource FilterChip}"
                                                 Content="{Binding}" Margin="0,0,6,0"
                                                 GroupName="HistCat"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Results list -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="16,0,16,16">
                    <StackPanel>
                        <!-- Empty state -->
                        <StackPanel HorizontalAlignment="Center" Margin="0,60"
                                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="📋" FontSize="40" HorizontalAlignment="Center"/>
                            <TextBlock Text="No service records found" FontSize="16" FontWeight="SemiBold"
                                       Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,10,0,4"/>
                            <TextBlock Text="Save your first RO to see history here" FontSize="13"
                                       Foreground="#636366" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding FilteredOrders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource HistoryCard}">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.SelectOrderCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Row 1: vehicle + status badge -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding VehicleLabel}"
                                                           FontSize="14" FontWeight="SemiBold"
                                                           Foreground="#FFFFFF"/>
                                                <Border Grid.Column="1" CornerRadius="6" Padding="8,3"
                                                        Background="{Binding StatusColor, Converter={StaticResource HexBrush}}">
                                                    <TextBlock Text="{Binding StatusLabel}" FontSize="11"
                                                               Foreground="#FFFFFF" FontWeight="Medium"/>
                                                </Border>
                                            </Grid>

                                            <!-- Row 2: customer + mileage -->
                                            <Grid Grid.Row="1" Margin="0,5,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="👤 " FontSize="12"/>
                                                    <TextBlock Text="{Binding CustomerName}" FontSize="12"
                                                               Foreground="#EBEBF5"
                                                               Visibility="{Binding HasCustomer, Converter={StaticResource BoolVis}}"/>
                                                    <TextBlock Text="Unknown customer" FontSize="12"
                                                               Foreground="#636366"
                                                               Visibility="{Binding HasCustomer, Converter={StaticResource InvBoolVis}}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding MileageLabel}"
                                                           FontSize="12" Foreground="#8E8E93"/>
                                            </Grid>

                                            <!-- Row 3: approval + date + advisor -->
                                            <Grid Grid.Row="2" Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border CornerRadius="5" Padding="7,2"
                                                        Background="{Binding ApprovalColor, Converter={StaticResource HexBrush}}"
                                                        Opacity="0.2" Width="0" HorizontalAlignment="Left"/>
                                                <TextBlock Text="{Binding ApprovalLabel}" FontSize="12"
                                                           Foreground="{Binding ApprovalColor, Converter={StaticResource HexBrush}}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DateLabel}"
                                                           FontSize="11" Foreground="#636366"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" FontSize="11" Foreground="#8E8E93"
                                                           Visibility="{Binding HasAdvisor, Converter={StaticResource BoolVis}}">
                                                    <TextBlock.Text>
                                                        <Binding Path="AdvisorName" StringFormat="· {0}"/>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- RIGHT: Detail panel -->
            <Grid Grid.Column="1" Background="#000000">
                <!-- No selection -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding HasSelectedOrder, Converter={StaticResource InvBoolVis}}">
                    <TextBlock Text="📋" FontSize="48" HorizontalAlignment="Center"/>
                    <TextBlock Text="Select a record" FontSize="16" FontWeight="SemiBold"
                               Foreground="#3A3A3C" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                    <TextBlock Text="to view service details" FontSize="13" Foreground="#3A3A3C"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Detail -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasSelectedOrder, Converter={StaticResource BoolVis}}">
                    <StackPanel Margin="20">

                        <!-- Header -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding SelectedOrder.VehicleLabel}"
                                       FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <Button Grid.Column="1" Content="✕" Background="Transparent"
                                    BorderThickness="0" Foreground="#636366" FontSize="14"
                                    Cursor="Hand" Command="{Binding ClearSelectionCommand}"/>
                        </Grid>

                        <!-- Info cards -->
                        <UniformGrid Columns="2" Margin="0,0,0,14">
                            <Border Background="#1C1C1E" CornerRadius="8" Padding="12" Margin="0,0,6,6">
                                <StackPanel>
                                    <TextBlock Text="CUSTOMER" FontSize="10" Foreground="#636366"/>
                                    <TextBlock Text="{Binding SelectedOrder.CustomerName}"
                                               FontSize="13" Foreground="#FFFFFF" Margin="0,3,0,0"/>
                                    <TextBlock Text="{Binding SelectedOrder.PhoneLabel}"
                                               FontSize="12" Foreground="#8E8E93"
                                               Visibility="{Binding SelectedOrder.HasPhone, Converter={StaticResource BoolVis}}"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#1C1C1E" CornerRadius="8" Padding="12" Margin="6,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="MILEAGE" FontSize="10" Foreground="#636366"/>
                                    <TextBlock Text="{Binding SelectedOrder.MileageLabel}"
                                               FontSize="13" Foreground="#FFFFFF" Margin="0,3,0,0"/>
                                    <TextBlock Text="{Binding SelectedOrder.DateLabel}"
                                               FontSize="12" Foreground="#8E8E93"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#1C1C1E" CornerRadius="8" Padding="12" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="ADVISOR" FontSize="10" Foreground="#636366"/>
                                    <TextBlock Text="{Binding SelectedOrder.AdvisorName}"
                                               FontSize="13" Foreground="#FFFFFF" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#1C1C1E" CornerRadius="8" Padding="12" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="APPROVAL" FontSize="10" Foreground="#636366"/>
                                    <TextBlock Text="{Binding SelectedOrder.ApprovalLabel}"
                                               FontSize="13" Margin="0,3,0,0">
                                        <TextBlock.Foreground>
                                            <Binding Path="SelectedOrder.ApprovalColor" Converter="{StaticResource HexBrush}"/>
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Services performed -->
                        <TextBlock Text="SERVICES" FontSize="11" Foreground="#636366"
                                   Margin="0,0,0,8"/>

                        <ItemsControl ItemsSource="{Binding SelectedServices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1C1C1E" CornerRadius="8" Padding="12,10" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Icon}" FontSize="14"
                                                       VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" FontSize="13"
                                                           Foreground="#FFFFFF"/>
                                                <TextBlock Text="{Binding Category}" FontSize="11"
                                                           Foreground="#8E8E93"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Price}"
                                                       FontSize="13" Foreground="#8E8E93"
                                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <Border Grid.Column="3" CornerRadius="5" Padding="8,3"
                                                    Background="{Binding StatusColor, Converter={StaticResource HexBrush}}"
                                                    Opacity="0.25">
                                                <TextBlock Text="{Binding StatusLabel}" FontSize="11"
                                                           Foreground="{Binding StatusColor, Converter={StaticResource HexBrush}}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

        </Grid>
    </Grid>
</UserControl>
