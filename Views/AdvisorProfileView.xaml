<UserControl x:Class="BayBrain.Views.AdvisorProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:BayBrain.Converters">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <conv:NullToVisibilityConverter x:Key="NullVis"/>
        <conv:ScoreColorConverter       x:Key="ScoreColor"/>
        <conv:StringNotEmptyConverter   x:Key="StrVis"/>
        <conv:EqualityToVisibilityConverter x:Key="EqVis"/>

        <Style x:Key="AvatarCircleStyle" TargetType="Border">
            <Setter Property="Width"  Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="CornerRadius" Value="24"/>
        </Style>

        <Style x:Key="ProfileCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FF1C1C1E"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SmallPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#FF0D0D0F">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── LEFT: Profile list ───────────────────────────────── -->
        <Border Grid.Column="0" Background="#FF1C1C1E"
                BorderBrush="#FF38383A" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="16,16,16,8">
                    <TextBlock Text="ADVISOR PROFILES"
                               Foreground="#FF636366" FontSize="10"
                               FontWeight="SemiBold"/>
                    <TextBlock Foreground="#FF8E8E93" FontSize="12" Margin="0,4,0,0">
                        <Run Text="{Binding AdvisorProfiles.Profiles.Count, Mode=OneWay, FallbackValue=0}"/>
                        <Run Text=" advisors registered"/>
                    </TextBlock>
                    <Rectangle Height="1" Fill="#FF38383A" Margin="0,12,0,0"/>
                </StackPanel>

                <!-- Profile list -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,4">
                    <StackPanel>
                        <!-- Empty state -->
                        <StackPanel Visibility="{Binding AdvisorProfiles.HasProfiles, Converter={StaticResource BoolVis}, ConverterParameter=invert}"
                                    HorizontalAlignment="Center" Margin="0,32,0,0">
                            <TextBlock Text="👤" FontSize="40" HorizontalAlignment="Center"/>
                            <TextBlock Text="No advisors yet" FontSize="14"
                                       Foreground="#FF8E8E93" HorizontalAlignment="Center"
                                       Margin="0,10,0,4"/>
                            <TextBlock Text="Add one below to start tracking" FontSize="12"
                                       Foreground="#FF636366" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Profile cards -->
                        <ItemsControl ItemsSource="{Binding AdvisorProfiles.Profiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ProfileCardStyle}">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.AdvisorProfiles.SelectAdvisorCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Avatar -->
                                            <Border Grid.Column="0" Style="{StaticResource AvatarCircleStyle}"
                                                    Background="{Binding AvatarColor}"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Initials}"
                                                           FontSize="16" FontWeight="Bold"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Name + stats -->
                                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="14" FontWeight="SemiBold"
                                                           Foreground="White"/>
                                                <TextBlock FontSize="11" Foreground="#FF8E8E93" Margin="0,3,0,0">
                                                    <Run Text="{Binding TotalSessionsCompleted}"/>
                                                    <Run Text=" sessions  ·  "/>
                                                    <Run Text="{Binding OverallAccuracy, StringFormat='{}{0:F0}'}"/>
                                                    <Run Text="% avg"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding RankTitle}"
                                                           FontSize="11" Foreground="#FF636366"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Active badge + delete -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <Border CornerRadius="6" Padding="8,3" Margin="0,0,0,6"
                                                        Background="#FF0A84FF">
                                                    <Border.Visibility>
                                                        <MultiBinding Converter="{StaticResource EqVis}">
                                                            <Binding Path="Id"/>
                                                            <Binding Path="DataContext.AdvisorProfiles.ActiveAdvisor.Id"
                                                                     RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                        </MultiBinding>
                                                    </Border.Visibility>
                                                    <TextBlock Text="ACTIVE" FontSize="9" FontWeight="Bold"
                                                               Foreground="White"/>
                                                </Border>
                                                <Button Content="✕" FontSize="11"
                                                        Foreground="#FF636366"
                                                        Background="Transparent" BorderThickness="0"
                                                        Cursor="Hand" Padding="4"
                                                        Command="{Binding DataContext.AdvisorProfiles.DeleteProfileCommand,
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Bottom: New advisor form -->
                <Border Grid.Row="2" Padding="12,12" BorderBrush="#FF38383A" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <!-- Create form (visible when creating) -->
                        <StackPanel Visibility="{Binding AdvisorProfiles.IsCreatingNew, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="NEW ADVISOR" Foreground="#FF636366"
                                        FontSize="10" FontWeight="SemiBold"
                                       Margin="0,0,0,10"/>
                            <TextBox Text="{Binding AdvisorProfiles.NewAdvisorName, UpdateSourceTrigger=PropertyChanged}"
                                     Height="36" FontSize="13"
                                     Background="#FF2C2C2E" Foreground="White"
                                     BorderBrush="#FF38383A" BorderThickness="1"
                                     Padding="10,6"/>

                            <!-- Color picker -->
                            <TextBlock Text="Avatar color:" FontSize="11"
                                       Foreground="#FF8E8E93" Margin="0,10,0,6"/>
                            <WrapPanel>
                                <Button Width="28" Height="28" Margin="3"
                                        Background="#FF0A84FF" BorderThickness="0" Cursor="Hand"
                                        Command="{Binding AdvisorProfiles.SetColorForNewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="#FF0A84FF"/>
                                <Button Width="28" Height="28" Margin="3"
                                        Background="#FF30D158" BorderThickness="0" Cursor="Hand"
                                        Command="{Binding AdvisorProfiles.SetColorForNewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="#FF30D158"/>
                                <Button Width="28" Height="28" Margin="3"
                                        Background="#FFFF9F0A" BorderThickness="0" Cursor="Hand"
                                        Command="{Binding AdvisorProfiles.SetColorForNewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="#FFFF9F0A"/>
                                <Button Width="28" Height="28" Margin="3"
                                        Background="#FFFF453A" BorderThickness="0" Cursor="Hand"
                                        Command="{Binding AdvisorProfiles.SetColorForNewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="#FFFF453A"/>
                                <Button Width="28" Height="28" Margin="3"
                                        Background="#FFBF5AF2" BorderThickness="0" Cursor="Hand"
                                        Command="{Binding AdvisorProfiles.SetColorForNewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="#FFBF5AF2"/>
                                <Button Width="28" Height="28" Margin="3"
                                        Background="#FF64D2FF" BorderThickness="0" Cursor="Hand"
                                        Command="{Binding AdvisorProfiles.SetColorForNewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="#FF64D2FF"/>
                            </WrapPanel>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Create"
                                        Background="#FF0A84FF" Foreground="White"
                                        FontWeight="SemiBold" FontSize="13"
                                        BorderThickness="0" Height="36"
                                        Cursor="Hand"
                                        Command="{Binding AdvisorProfiles.CreateProfileCommand}"/>
                                <Button Grid.Column="2" Content="Cancel"
                                        Background="#FF2C2C2E" Foreground="#FF8E8E93"
                                        FontSize="13" BorderThickness="0"
                                        Height="36" Padding="16,0" Cursor="Hand"
                                        Command="{Binding AdvisorProfiles.CancelNewCommand}"/>
                            </Grid>
                        </StackPanel>

                        <!-- Add button (visible when NOT creating) -->
                        <Button Content="＋  Add Advisor"
                                Background="#FF0A84FF" Foreground="White"
                                FontWeight="SemiBold" FontSize="14"
                                BorderThickness="0" Height="40"
                                Cursor="Hand"
                                Command="{Binding AdvisorProfiles.StartCreatingNewCommand}"
                                Visibility="{Binding AdvisorProfiles.IsCreatingNew, Converter={StaticResource BoolVis}, ConverterParameter=invert}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ── RIGHT: Selected profile detail / leaderboard ──── -->
        <Grid Grid.Column="1">

            <!-- Nothing selected -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding AdvisorProfiles.SelectedProfile, Converter={StaticResource NullVis}, ConverterParameter=invert}">
                <TextBlock Text="👤" FontSize="64" HorizontalAlignment="Center"/>
                <TextBlock Text="Select an advisor to view their stats"
                           HorizontalAlignment="Center" FontSize="16"
                           Foreground="#FF8E8E93" Margin="0,16,0,0"/>
                <TextBlock Text="Or switch to the Leaderboard tab"
                           HorizontalAlignment="Center" FontSize="12"
                           Foreground="#FF636366" Margin="0,6,0,0"/>

                <!-- Leaderboard toggle -->
                <Button Content="🏆  View Leaderboard"
                        Background="#FF0A84FF" Foreground="White"
                        FontWeight="SemiBold" FontSize="14"
                        BorderThickness="0" Height="42" Padding="28,0"
                        Cursor="Hand" Margin="0,24,0,0"
                        HorizontalAlignment="Center"
                        Command="{Binding AdvisorProfiles.ToggleLeaderboardCommand}"
                        Visibility="{Binding AdvisorProfiles.HasProfiles, Converter={StaticResource BoolVis}}"/>
            </StackPanel>

            <!-- Leaderboard overlay -->
            <Border Background="#FF0D0D0F"
                    Visibility="{Binding AdvisorProfiles.ShowLeaderboard, Converter={StaticResource BoolVis}}">
                <Grid MaxWidth="680" HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="0,28,0,0">
                        <Grid>
                            <TextBlock Text="Leaderboard" FontSize="26" FontWeight="Bold"
                                       Foreground="White"/>
                            <Button Content="✕  Close" HorizontalAlignment="Right"
                                    Background="Transparent" Foreground="#FF8E8E93"
                                    BorderThickness="0" FontSize="13" Cursor="Hand"
                                    Command="{Binding AdvisorProfiles.ToggleLeaderboardCommand}"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" Padding="0,16,0,28" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding AdvisorProfiles.Leaderboard}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FF1C1C1E" CornerRadius="16"
                                                Padding="20,16" Margin="0,0,0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="50"/>
                                                    <ColumnDefinition Width="52"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="120"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Rank -->
                                                <TextBlock Grid.Column="0" Text="{Binding RankDisplay}"
                                                           FontSize="22" VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"/>

                                                <!-- Avatar -->
                                                <Border Grid.Column="1"
                                                        Width="44" Height="44" CornerRadius="22"
                                                        Background="{Binding Profile.AvatarColor}"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Profile.Initials}"
                                                               FontSize="15" FontWeight="Bold"
                                                               Foreground="White"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Name + rank title -->
                                                <StackPanel Grid.Column="2" Margin="14,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Profile.Name}"
                                                               FontSize="15" FontWeight="SemiBold"
                                                               Foreground="White"/>
                                                    <TextBlock Text="{Binding Profile.RankTitle}"
                                                               FontSize="12" Foreground="#FF8E8E93"
                                                               Margin="0,3,0,0"/>
                                                </StackPanel>

                                                <!-- Sessions -->
                                                <StackPanel Grid.Column="3" HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Profile.TotalSessionsCompleted}"
                                                               FontSize="22" FontWeight="Bold"
                                                               Foreground="White" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="sessions" FontSize="11"
                                                               Foreground="#FF636366" HorizontalAlignment="Center"/>
                                                </StackPanel>

                                                <!-- Accuracy -->
                                                <StackPanel Grid.Column="4" HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                    <TextBlock FontSize="22" FontWeight="Bold"
                                                               HorizontalAlignment="Center">
                                                        <TextBlock.Foreground>
                                                            <Binding Path="Profile.OverallAccuracy" Converter="{StaticResource ScoreColor}"/>
                                                        </TextBlock.Foreground>
                                                        <Run Text="{Binding Profile.OverallAccuracy, StringFormat='{}{0:F0}'}"/>
                                                        <Run Text="%" FontSize="16"/>
                                                    </TextBlock>
                                                    <TextBlock Text="accuracy" FontSize="11"
                                                               Foreground="#FF636366" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Empty leaderboard -->
                            <StackPanel HorizontalAlignment="Center" Margin="0,40,0,0"
                                        Visibility="{Binding AdvisorProfiles.Leaderboard.Count, Mode=OneWay,
                                            Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                                <TextBlock Text="🏆" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="No completed sessions yet"
                                           FontSize="15" Foreground="#FF8E8E93"
                                           HorizontalAlignment="Center" Margin="0,12,0,0"/>
                                <TextBlock Text="Complete a quiz to appear on the leaderboard"
                                           FontSize="12" Foreground="#FF636366"
                                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Profile detail (selected, not leaderboard) -->
            <ScrollViewer Padding="28" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding AdvisorProfiles.SelectedProfile, Converter={StaticResource NullVis}}">
                <StackPanel MaxWidth="880">

                    <!-- Profile header -->
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="72" Height="72" CornerRadius="36"
                                Background="{Binding AdvisorProfiles.SelectedProfile.AvatarColor}">
                            <TextBlock Text="{Binding AdvisorProfiles.SelectedProfile.Initials}"
                                       FontSize="26" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding AdvisorProfiles.SelectedProfile.Name}"
                                       FontSize="26" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="{Binding AdvisorProfiles.SelectedProfile.RankTitle}"
                                       FontSize="14" Foreground="#FF0A84FF"
                                       FontWeight="SemiBold" Margin="0,4,0,0"/>
                            <TextBlock FontSize="12" Foreground="#FF636366" Margin="0,3,0,0">
                                <Run Text="Member since "/>
                                <Run Text="{Binding AdvisorProfiles.SelectedProfile.CreatedAt, StringFormat='MMMM yyyy'}"/>
                            </TextBlock>
                        </StackPanel>

                        <Button Grid.Column="2" Content="🏆  Leaderboard"
                                Background="#FF2C2C2E" Foreground="#FF0A84FF"
                                FontWeight="SemiBold" FontSize="13"
                                BorderThickness="0" Height="38" Padding="18,0"
                                Cursor="Hand" VerticalAlignment="Top"
                                Command="{Binding AdvisorProfiles.ToggleLeaderboardCommand}"/>
                    </Grid>

                    <!-- Stats cards row -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Sessions -->
                        <Border Grid.Column="0" Background="#FF1C1C1E" CornerRadius="14" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="SESSIONS" Foreground="#FF636366" FontSize="9"
                                           FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding AdvisorProfiles.SelectedProfile.TotalSessionsCompleted}"
                                           FontSize="32" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="completed" FontSize="11" Foreground="#FF636366"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Accuracy -->
                        <Border Grid.Column="2" Background="#FF1C1C1E" CornerRadius="14" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="ACCURACY" Foreground="#FF636366" FontSize="9"
                                           FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBlock FontSize="32" FontWeight="Bold" HorizontalAlignment="Center">
                                    <TextBlock.Foreground>
                                        <Binding Path="AdvisorProfiles.SelectedProfile.OverallAccuracy"
                                                 Converter="{StaticResource ScoreColor}"/>
                                    </TextBlock.Foreground>
                                    <Run Text="{Binding AdvisorProfiles.SelectedProfile.OverallAccuracy, StringFormat='{}{0:F0}'}"/>
                                    <Run Text="%" FontSize="22"/>
                                </TextBlock>
                                <TextBlock Text="overall" FontSize="11" Foreground="#FF636366"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Best score -->
                        <Border Grid.Column="4" Background="#FF1C1C1E" CornerRadius="14" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="BEST SCORE" Foreground="#FF636366" FontSize="9"
                                           FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBlock FontSize="32" FontWeight="Bold" HorizontalAlignment="Center"
                                           Foreground="#FFFFD700">
                                    <Run Text="{Binding AdvisorProfiles.SelectedProfile.BestScore, StringFormat='{}{0:F0}'}"/>
                                    <Run Text="%" FontSize="22" Foreground="#FFFFD700"/>
                                </TextBlock>
                                <TextBlock Text="personal best" FontSize="11" Foreground="#FF636366"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Trend -->
                        <Border Grid.Column="6" Background="#FF1C1C1E" CornerRadius="14" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="TREND" Foreground="#FF636366" FontSize="9"
                                           FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBlock FontSize="32" FontWeight="Bold" HorizontalAlignment="Center">
                                    <TextBlock.Foreground>
                                        <Binding Path="AdvisorProfiles.SelectedProfile.RecentTrend"
                                                 Converter="{StaticResource ScoreColor}"/>
                                    </TextBlock.Foreground>
                                    <Run Text="{Binding AdvisorProfiles.SelectedProfile.RecentTrend, StringFormat='{}{0:+0.0;-0.0;0.0}'}"/>
                                    <Run Text="%" FontSize="22"/>
                                </TextBlock>
                                <TextBlock Text="recent trend" FontSize="11" Foreground="#FF636366"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Strengths/weaknesses row -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#FF1C1C1E" CornerRadius="14" Padding="16">
                            <StackPanel>
                                <TextBlock Text="💪  STRONGEST CATEGORY" Foreground="#FF636366"
                                           FontSize="9" FontWeight="SemiBold"
                                           Margin="0,0,0,10"/>
                                <TextBlock Text="{Binding AdvisorProfiles.SelectedProfile.StrongestCategory}"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="#FF30D158"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#FF1C1C1E" CornerRadius="14" Padding="16">
                            <StackPanel>
                                <TextBlock Text="📚  NEEDS IMPROVEMENT" Foreground="#FF636366"
                                           FontSize="9" FontWeight="SemiBold"
                                           Margin="0,0,0,10"/>
                                <TextBlock Text="{Binding AdvisorProfiles.SelectedProfile.WeakestCategory}"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="#FFFF9F0A"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Session history -->
                    <TextBlock Text="Session History" FontSize="18" FontWeight="Bold"
                               Foreground="White" Margin="0,0,0,12"/>

                    <!-- History empty -->
                    <TextBlock Text="No sessions completed yet — take a quiz to start tracking!"
                               FontSize="13" Foreground="#FF8E8E93"
                               Visibility="{Binding AdvisorProfiles.SessionHistory.Count, Mode=OneWay,
                                   Converter={StaticResource BoolVis}, ConverterParameter=invert}"/>

                    <ItemsControl ItemsSource="{Binding AdvisorProfiles.SessionHistory}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FF1C1C1E" CornerRadius="12"
                                        Padding="16,12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Index}"
                                                   FontSize="12" Foreground="#FF636366"
                                                   VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DateLabel}"
                                                       FontSize="13" Foreground="White"/>
                                            <TextBlock Text="{Binding CategoryLabel}"
                                                       FontSize="11" Foreground="#FF8E8E93"
                                                       Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Session.DurationSeconds, StringFormat='{}{0}s'}"
                                                   FontSize="12" Foreground="#FF636366"
                                                   VerticalAlignment="Center" Margin="0,0,16,0"/>

                                        <TextBlock Grid.Column="3" Text="{Binding ScoreLabel}"
                                                   FontSize="15" FontWeight="Bold"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Foreground>
                                                <SolidColorBrush Color="{Binding ScoreColor}"/>
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
