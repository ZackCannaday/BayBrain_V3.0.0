<Window x:Class="BayBrain.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BayBrain.ViewModels"
        xmlns:conv="clr-namespace:BayBrain.Converters"
        xmlns:views="clr-namespace:BayBrain.Views"
        Title="BayBrain — Service Advisor Intelligence"
        Width="1280" Height="800"
        MinWidth="1000" MinHeight="640"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#FF0D0D0F"
        FontFamily="Segoe UI"
        FocusManager.FocusedElement="{Binding ElementName=MainSearchBox}">

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="D1" Command="{Binding NavigateToCommand}" CommandParameter="0"/>
        <KeyBinding Modifiers="Control" Key="D2" Command="{Binding NavigateToCommand}" CommandParameter="1"/>
        <KeyBinding Modifiers="Control" Key="D3" Command="{Binding NavigateToCommand}" CommandParameter="2"/>
        <KeyBinding Modifiers="Control" Key="D4" Command="{Binding NavigateToCommand}" CommandParameter="3"/>
        <KeyBinding Modifiers="Control" Key="D5" Command="{Binding NavigateToCommand}" CommandParameter="4"/>
        <KeyBinding Modifiers="Control" Key="D6" Command="{Binding NavigateToCommand}" CommandParameter="5"/>
        <KeyBinding Modifiers="Control" Key="D7" Command="{Binding NavigateToCommand}" CommandParameter="6"/>
        <KeyBinding Modifiers="Control" Key="D8" Command="{Binding NavigateToCommand}" CommandParameter="7"/>
    </Window.InputBindings>



    <Window.Resources>
        <!-- Converters are now registered globally in Themes/DarkTheme.xaml -->
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════════════ -->
        <!-- Title / Nav Bar                                               -->
        <!-- ══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="#1C1C1E"
                BorderBrush="#38383A"
                BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🧠" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="BayBrain" FontSize="18" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text=" · Service Advisor Intelligence"
                               FontSize="13" Foreground="#8E8E93" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Navigation buttons (centred) -->
                <ScrollViewer Grid.Column="1"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              Margin="18,0"
                              VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

                    <Button Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding NavigateToCommand}" CommandParameter="0" Margin="2,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📚" Margin="0,0,5,0"/>
                            <TextBlock Text="Service Catalog"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding NavigateToCommand}" CommandParameter="1" Margin="2,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔧" Margin="0,0,5,0"/>
                            <TextBlock Text="RO Mode"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding NavigateToCommand}" CommandParameter="2" Margin="2,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎯" Margin="0,0,5,0"/>
                            <TextBlock Text="Quiz"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding NavigateToCommand}" CommandParameter="3" Margin="2,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤" Margin="0,0,5,0"/>
                            <TextBlock Text="Profiles"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding NavigateToCommand}" CommandParameter="4" Margin="2,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" Margin="0,0,5,0"/>
                            <TextBlock Text="Dashboard"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding NavigateToCommand}" CommandParameter="5" Margin="2,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" Margin="0,0,5,0"/>
                            <TextBlock Text="History"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding NavigateToCommand}" CommandParameter="6" Margin="2,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️" Margin="0,0,5,0"/>
                            <TextBlock Text="Settings"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                </ScrollViewer>

                <!-- Right: current session + active advisor -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border CornerRadius="16" Padding="10,5" Margin="0,0,10,0"
                            Background="#182335"
                            Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding CurrentUserDisplayName}"
                                       FontSize="12" FontWeight="SemiBold" Foreground="White"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CurrentUserRoleLabel, StringFormat='  ·  {0}'}"
                                       FontSize="11" Foreground="#FF64D2FF"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="16" Padding="10,5" Margin="0,0,14,0"
                            Background="#2C2C2E"
                            Visibility="{Binding AdvisorProfiles.ActiveAdvisor, Converter={StaticResource NullVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="22" Height="22" CornerRadius="11"
                                    Background="{Binding AdvisorProfiles.ActiveAdvisor.AvatarColor}"
                                    Margin="0,0,7,0">
                                <TextBlock Text="{Binding AdvisorProfiles.ActiveAdvisor.Initials}"
                                           FontSize="9" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding AdvisorProfiles.ActiveAdvisor.Name}"
                                       FontSize="12" FontWeight="SemiBold" Foreground="White"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Button Content="Sign out"
                            Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding LogoutCommand}"
                            Margin="0,0,10,0"
                            Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolVis}}"/>
                    <TextBlock Text="BayBrain v3.0" FontSize="11" Foreground="#636366"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════ -->
        <!-- Tab Content                                                    -->
        <!-- ══════════════════════════════════════════════════════════════ -->
        <TabControl Grid.Row="1"
                    SelectedIndex="{Binding SelectedTabIndex}"
                    Background="#0D0D0F"
                    BorderThickness="0" Padding="0">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <ContentPresenter ContentSource="SelectedContent"/>
                </ControlTemplate>
            </TabControl.Template>

            <!-- ── Tab 0: Service Catalog ──────────────────────────────── -->
            <TabItem>
                <views:SearchView/>
            </TabItem>

            <!-- ── Tab 1: RO Mode ──────────────────────────────────────── -->
            <TabItem>
                <views:ROView/>
            </TabItem>

            <!-- ── Tab 2: Quiz ─────────────────────────────────────────── -->
            <TabItem>
                <views:QuizView/>
            </TabItem>

            <!-- ── Tab 3: Advisor Profiles ─────────────────────────────── -->
            <TabItem>
                <views:AdvisorProfileView/>
            </TabItem>

            <!-- ── Tab 4: Dashboard ────────────────────────────────────── -->
            <TabItem>
                <views:DashboardView DataContext="{Binding Dashboard}"/>
            </TabItem>

            <!-- ── Tab 5: History ──────────────────────────────────────── -->
            <TabItem>
                <views:HistoryView DataContext="{Binding History}"/>
            </TabItem>

            <!-- ── Tab 6: Settings ─────────────────────────────────────── -->
            <TabItem>
                <Grid>
                    <views:SettingsView DataContext="{Binding Settings}"
                                        Visibility="{Binding CanAccessSettings, Converter={StaticResource BoolVis}}"/>
                    <Border Background="#FF0D0D0F"
                            Visibility="{Binding CanAccessSettings, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                        <StackPanel Width="440" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="Settings Restricted"
                                       FontSize="24" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Settings are only available to Manager and Admin users. Sign out and use an authorized account to make application or account changes."
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="#FF8E8E93" FontSize="13"
                                       Margin="0,10,0,18"/>
                            <Button Content="Sign out"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding LogoutCommand}"
                                    Width="140"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- ══════════════════════════════════════════════════════════════ -->
        <!-- Status bar                                                     -->
        <!-- ══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="#1C1C1E"
                BorderBrush="#38383A"
                BorderThickness="0,1,0,0"
                Padding="20,8"
                Visibility="{Binding HasStatus, Converter={StaticResource BoolVis}}">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="#30D158" FontSize="13"
                       FontWeight="SemiBold"/>
        </Border>

        <!-- Full-app local login gate -->
        <Border Grid.RowSpan="3"
                Background="#F70D0D0F"
                Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolVis}, ConverterParameter=invert}"
                Panel.ZIndex="50">
            <Grid>
                <Border Width="460"
                        Padding="28"
                        CornerRadius="14"
                        Background="#FF1C1C1E"
                        BorderBrush="#FF38383A"
                        BorderThickness="1"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="BayBrain"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Sign in to access desktop workflows"
                                   FontSize="13"
                                   Foreground="#FF8E8E93"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,24"/>

                        <TextBlock Text="USER"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#FF636366"
                                   Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding LoginUsers}"
                                  SelectedItem="{Binding SelectedLoginUser}"
                                  DisplayMemberPath="DisplayName"
                                  Height="40"
                                  FontSize="14"
                                  Margin="0,0,0,14"/>

                        <TextBlock Text="PIN"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#FF636366"
                                   Margin="0,0,0,6"/>
                        <PasswordBox x:Name="LoginPinBox"
                                     PasswordChanged="LoginPinBox_PasswordChanged"
                                     MaxLength="12"
                                     MinHeight="42"
                                     FontSize="18"
                                     HorizontalContentAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     Margin="0,0,0,14">
                            <PasswordBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding LoginCommand}"/>
                            </PasswordBox.InputBindings>
                        </PasswordBox>

                        <Button Content="Sign in"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding LoginCommand}"
                                Height="42"
                                Margin="0,0,0,12"/>

                        <TextBlock Text="{Binding LoginMessage}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Foreground="#FFFF9F0A"
                                   FontSize="12"/>

                        <Border Background="#FF111113"
                                CornerRadius="8"
                                Padding="12,10"
                                Margin="0,18,0,0">
                            <TextBlock Text="First run creates a local Administrator account with PIN 0000. Change user PINs from Settings once account management is configured."
                                       TextWrapping="Wrap"
                                       Foreground="#FF636366"
                                       FontSize="12"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

    </Grid>
</Window>
