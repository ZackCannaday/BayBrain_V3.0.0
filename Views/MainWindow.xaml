<Window x:Class="BayBrain.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BayBrain.ViewModels"
        xmlns:conv="clr-namespace:BayBrain.Converters"
        xmlns:views="clr-namespace:BayBrain.Views"
        Title="BayBrain — Service Advisor Intelligence"
        Width="1440" Height="900"
        MinWidth="1100" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#FF0D0D0F"
        FontFamily="Segoe UI">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <conv:BoolToVisibilityConverter          x:Key="BoolVis"/>
        <conv:NullToVisibilityConverter          x:Key="NullVis"/>
        <conv:UrgencyColorConverter              x:Key="UrgencyColor"/>
        <conv:UrgencyLabelConverter              x:Key="UrgencyLabel"/>
        <conv:ScoreBarWidthConverter             x:Key="ScoreBarWidth"/>
        <conv:CategoryIconConverter              x:Key="CatIcon"/>
        <conv:StringNotEmptyConverter            x:Key="StrVis"/>
        <conv:ScoreColorConverter                x:Key="ScoreColor"/>
        <conv:QuizProgressConverter              x:Key="QuizProgress"/>
        <conv:HexStringToBrushConverter          x:Key="HexBrush"/>
        <conv:InverseBoolToVisibilityConverter   x:Key="InvBoolVis"/>
        <conv:PositiveIntToVisibilityConverter   x:Key="PosIntVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════════════ -->
        <!-- Title / Nav Bar                                               -->
        <!-- ══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="#1C1C1E"
                BorderBrush="#38383A"
                BorderThickness="0,0,0,1">
            <Grid Margin="20,0">

                <!-- Logo -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🧠" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="BayBrain" FontSize="18" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text=" · Service Advisor Intelligence"
                               FontSize="13" Foreground="#8E8E93" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Navigation buttons (centred) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

                    <Button Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding NavigateToCommand}" CommandParameter="0" Margin="2,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" Margin="0,0,5,0"/>
                            <TextBlock Text="Search"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding NavigateToCommand}" CommandParameter="1" Margin="2,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📚" Margin="0,0,5,0"/>
                            <TextBlock Text="Services"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding NavigateToCommand}" CommandParameter="2" Margin="2,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔧" Margin="0,0,5,0"/>
                            <TextBlock Text="RO Mode"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding NavigateToCommand}" CommandParameter="3" Margin="2,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎯" Margin="0,0,5,0"/>
                            <TextBlock Text="Quiz"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding NavigateToCommand}" CommandParameter="4" Margin="2,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤" Margin="0,0,5,0"/>
                            <TextBlock Text="Profiles"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding NavigateToCommand}" CommandParameter="5" Margin="2,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" Margin="0,0,5,0"/>
                            <TextBlock Text="Dashboard"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding NavigateToCommand}" CommandParameter="6" Margin="2,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" Margin="0,0,5,0"/>
                            <TextBlock Text="History"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding NavigateToCommand}" CommandParameter="7" Margin="2,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️" Margin="0,0,5,0"/>
                            <TextBlock Text="Settings"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Right: active advisor chip + version -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border CornerRadius="16" Padding="10,5" Margin="0,0,14,0"
                            Background="#2C2C2E"
                            Visibility="{Binding AdvisorProfiles.ActiveAdvisor, Converter={StaticResource NullVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="22" Height="22" CornerRadius="11"
                                    Background="{Binding AdvisorProfiles.ActiveAdvisor.AvatarColor}"
                                    Margin="0,0,7,0">
                                <TextBlock Text="{Binding AdvisorProfiles.ActiveAdvisor.Initials}"
                                           FontSize="9" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding AdvisorProfiles.ActiveAdvisor.Name}"
                                       FontSize="12" FontWeight="SemiBold" Foreground="White"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="BayBrain v3.0" FontSize="11" Foreground="#636366"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════ -->
        <!-- Tab Content                                                    -->
        <!-- ══════════════════════════════════════════════════════════════ -->
        <TabControl Grid.Row="1"
                    SelectedIndex="{Binding SelectedTabIndex}"
                    Background="#0D0D0F"
                    BorderThickness="0" Padding="0">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <ContentPresenter ContentSource="SelectedContent"/>
                </ControlTemplate>
            </TabControl.Template>

            <!-- ── Tab 0: Search + Detail ──────────────────────────────── -->
            <TabItem>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" MinWidth="280" MaxWidth="440"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: Search panel -->
                    <Border Grid.Column="0" Background="#1C1C1E"
                            BorderBrush="#38383A" BorderThickness="0,0,1,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="14,14,14,0">
                                <TextBlock Text="SERVICE SEARCH"
                                           Foreground="#636366" FontSize="10"
                                           FontWeight="SemiBold"
                                           Margin="2,0,0,8"/>

                                <!-- Search box -->
                                <Grid>
                                    <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource SearchBoxStyle}" Height="44"/>
                                    <TextBlock Text="🔍" FontSize="15"
                                               HorizontalAlignment="Left" VerticalAlignment="Center"
                                               Margin="14,0,0,0" IsHitTestVisible="False"/>
                                    <TextBlock Text="Search services, symptoms, parts…"
                                               HorizontalAlignment="Left" VerticalAlignment="Center"
                                               Margin="44,0,0,0" Foreground="#636366" FontSize="13"
                                               IsHitTestVisible="False"
                                               Visibility="{Binding SearchQuery, Converter={StaticResource StrVis}, ConverterParameter=invert}"/>
                                </Grid>

                                <!-- Category filter -->
                                <ComboBox Margin="0,8,0,0" Height="36"
                                          ItemsSource="{Binding Categories}"
                                          SelectedItem="{Binding SelectedCategory}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding}"/></DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <Button Content="✕  Clear" Style="{StaticResource GhostButtonStyle}"
                                        Command="{Binding ClearSearchCommand}"
                                        HorizontalAlignment="Right" FontSize="11"
                                        Padding="8,4" Margin="0,4,0,0"/>

                                <Rectangle Height="1" Fill="#38383A" Margin="0,8,0,0"/>
                            </StackPanel>

                            <!-- Results list -->
                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding SearchResults}"
                                     SelectedItem="{Binding SelectedService}"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ItemContainerStyle="{StaticResource ServiceListItemStyle}"
                                     Padding="14,6,14,14">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Category, Converter={StaticResource CatIcon}}"
                                                       FontSize="17" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Margin="8,0">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                                <TextBlock Text="{Binding Category}"
                                                           FontSize="11" Foreground="#8E8E93" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding PriceRange}"
                                                       FontSize="11" Foreground="#8E8E93"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- RIGHT: Detail panel -->
                    <Grid Grid.Column="1">
                        <!-- Empty state -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding SelectedService, Converter={StaticResource NullVis}, ConverterParameter=invert}">
                            <TextBlock Text="🔍" FontSize="60" HorizontalAlignment="Center"/>
                            <TextBlock Text="Select a service to view details"
                                       HorizontalAlignment="Center" FontSize="16"
                                       Foreground="#8E8E93" Margin="0,16,0,0"/>
                            <TextBlock Text="Use the search panel on the left"
                                       HorizontalAlignment="Center" FontSize="12"
                                       Foreground="#636366" Margin="0,6,0,0"/>
                        </StackPanel>

                        <!-- Detail panel -->
                        <ScrollViewer Padding="28"
                                      Visibility="{Binding SelectedService, Converter={StaticResource NullVis}}"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="900">

                                <!-- Header -->
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedService.Name}"
                                                   FontSize="28" FontWeight="Bold" Foreground="White"/>
                                        <TextBlock Text="{Binding SelectedService.Category}"
                                                   Foreground="#0A84FF" FontSize="13"
                                                   FontWeight="SemiBold" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding SelectedService.PriceRange}"
                                                   FontSize="22" FontWeight="Bold" Foreground="White"
                                                   HorizontalAlignment="Right"/>
                                        <TextBlock HorizontalAlignment="Right"
                                                   FontSize="12" Foreground="#8E8E93">
                                            <Run Text="{Binding SelectedService.EstimatedMinutes}"/>
                                            <Run Text=" min  ·  est. time"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>

                                <!-- Urgency card -->
                                <Border Background="#1C1C1E" CornerRadius="16"
                                        Padding="18,16" Margin="0,0,0,14"
                                        Visibility="{Binding CurrentUrgency, Converter={StaticResource NullVis}}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <TextBlock Text="URGENCY SCORE"
                                                       Foreground="#636366" FontSize="10"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Border CornerRadius="8" Padding="12,5"
                                                        Background="{Binding CurrentUrgency, Converter={StaticResource UrgencyColor}}">
                                                    <TextBlock Text="{Binding CurrentUrgency, Converter={StaticResource UrgencyLabel}}"
                                                               FontSize="11" FontWeight="Bold" Foreground="White"/>
                                                </Border>
                                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center"
                                                           Foreground="White" FontSize="22" FontWeight="Bold">
                                                    <Run Text="{Binding CurrentUrgency.Score}"/>
                                                    <Run Text=" / 10" Foreground="#636366"
                                                         FontSize="14" FontWeight="Normal"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                        <Border Background="#2C2C2E" CornerRadius="4" Height="8">
                                            <Border CornerRadius="4" Height="8" HorizontalAlignment="Left"
                                                    Background="{Binding CurrentUrgency, Converter={StaticResource UrgencyColor}}"
                                                    Width="{Binding CurrentUrgency, Converter={StaticResource ScoreBarWidth}}"/>
                                        </Border>
                                        <TextBlock Text="{Binding CurrentUrgency.Reasoning}"
                                                   FontSize="12" Foreground="#8E8E93"
                                                   Margin="0,10,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Urgency modifiers -->
                                <Border Background="#1C1C1E" CornerRadius="16"
                                        Padding="18,16" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="URGENCY MODIFIERS"
                                                   Foreground="#636366" FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,14"/>
                                        <Grid Margin="0,0,0,10">
                                            <TextBlock Text="Miles overdue:"
                                                       FontSize="13" Foreground="#8E8E93"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock HorizontalAlignment="Right"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="#0A84FF" VerticalAlignment="Center">
                                                <Run Text="{Binding MilesOverdue, StringFormat='{}{0:N0}'}"/>
                                                <Run Text=" mi"/>
                                            </TextBlock>
                                        </Grid>
                                        <Slider Minimum="0" Maximum="20000"
                                                Value="{Binding MilesOverdue}"
                                                Foreground="#0A84FF"
                                                Margin="0,0,0,14"/>
                                        <CheckBox Content="Customer reports active symptoms"
                                                  IsChecked="{Binding HasSymptoms}"
                                                  Foreground="White" FontSize="13"/>
                                    </StackPanel>
                                </Border>

                                <!-- About card -->
                                <Border Background="#1C1C1E" CornerRadius="16"
                                        Padding="18,16" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="ABOUT THIS SERVICE"
                                                   Foreground="#636366" FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,12"/>
                                        <TextBlock Text="{Binding SelectedService.DetailedDescription}"
                                                   Foreground="White" FontSize="14"
                                                   TextWrapping="Wrap" LineHeight="24"/>
                                        <Rectangle Height="1" Fill="#38383A" Margin="0,14"/>
                                        <Border Background="#2C2C2E" CornerRadius="12" Padding="14">
                                            <StackPanel>
                                                <TextBlock Text="💡  WHY IT MATTERS"
                                                           Foreground="#636366" FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Margin="0,0,0,8"/>
                                                <TextBlock Text="{Binding SelectedService.WhyItMatters}"
                                                           Foreground="White" FontSize="13"
                                                           TextWrapping="Wrap" LineHeight="22"/>
                                            </StackPanel>
                                        </Border>
                                        <Rectangle Height="1" Fill="#38383A" Margin="0,14"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#2C2C2E" CornerRadius="12" Padding="14">
                                                <StackPanel>
                                                    <TextBlock Text="⏱  INTERVAL"
                                                               Foreground="#636366" FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Margin="0,0,0,8"/>
                                                    <TextBlock Text="{Binding SelectedService.Interval}"
                                                               Foreground="White" FontSize="13"
                                                               TextWrapping="Wrap" LineHeight="20"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="2" Background="#2C2C2E" CornerRadius="12" Padding="14">
                                                <StackPanel>
                                                    <TextBlock Text="⚠  IF SKIPPED"
                                                               Foreground="#636366" FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Margin="0,0,0,8"/>
                                                    <TextBlock Text="{Binding SelectedService.SkipConsequence}"
                                                               Foreground="#FF9500" FontSize="13"
                                                               TextWrapping="Wrap" LineHeight="20"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Script generator card -->
                                <Border Background="#1C1C1E" CornerRadius="16"
                                        Padding="18,16" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="CUSTOMER SCRIPT GENERATOR"
                                                   Foreground="#636366" FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,14"/>

                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Customer / Vehicle:"
                                                       FontSize="13" Foreground="#8E8E93"
                                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="36" FontSize="13"
                                                     Background="#2C2C2E" Foreground="White"
                                                     BorderBrush="#38383A" BorderThickness="1"
                                                     Padding="10,6"/>
                                        </Grid>

                                        <Border Background="#0D0D0F" CornerRadius="12"
                                                Padding="18" Margin="0,0,0,14"
                                                Visibility="{Binding GeneratedScript, Converter={StaticResource StrVis}}">
                                            <TextBlock Text="{Binding GeneratedScript}"
                                                       Foreground="#EBEBF5" FontSize="14"
                                                       TextWrapping="Wrap" LineHeight="26"
                                                       FontStyle="Italic"/>
                                        </Border>

                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding GeneratedScript, Converter={StaticResource StrVis}}">
                                            <Button Content="📋  Copy"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Command="{Binding CopyScriptCommand}"
                                                    Margin="0,0,10,0"/>
                                            <Button Content="🖨  Print"
                                                    Style="{StaticResource GhostButtonStyle}"
                                                    Command="{Binding PrintScriptCommand}"
                                                    Margin="0,0,10,0"/>
                                            <Button Content="💾  Export HTML"
                                                    Style="{StaticResource GhostButtonStyle}"
                                                    Command="{Binding ExportScriptCommand}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ── Tab 1: Service Browser ──────────────────────────────── -->
            <TabItem>
                <views:ServiceBrowserView/>
            </TabItem>

            <!-- ── Tab 2: RO Mode ──────────────────────────────────────── -->
            <TabItem>
                <views:ROView DataContext="{Binding RoMode}"/>
            </TabItem>

            <!-- ── Tab 3: Quiz ─────────────────────────────────────────── -->
            <TabItem>
                <views:QuizView DataContext="{Binding Quiz}"/>
            </TabItem>

            <!-- ── Tab 4: Advisor Profiles ─────────────────────────────── -->
            <TabItem>
                <views:AdvisorProfileView DataContext="{Binding AdvisorProfiles}"/>
            </TabItem>

            <!-- ── Tab 5: Dashboard ────────────────────────────────────── -->
            <TabItem>
                <views:DashboardView DataContext="{Binding Dashboard}"/>
            </TabItem>

            <!-- ── Tab 6: History ──────────────────────────────────────── -->
            <TabItem>
                <views:HistoryView DataContext="{Binding History}"/>
            </TabItem>

            <!-- ── Tab 7: Settings ─────────────────────────────────────── -->
            <TabItem>
                <views:SettingsView DataContext="{Binding Settings}"/>
            </TabItem>

        </TabControl>

        <!-- ══════════════════════════════════════════════════════════════ -->
        <!-- Status bar                                                     -->
        <!-- ══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="#1C1C1E"
                BorderBrush="#38383A"
                BorderThickness="0,1,0,0"
                Padding="20,8"
                Visibility="{Binding HasStatus, Converter={StaticResource BoolVis}}">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="#30D158" FontSize="13"
                       FontWeight="SemiBold"/>
        </Border>

    </Grid>
</Window>
