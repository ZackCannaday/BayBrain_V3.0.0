<UserControl x:Class="BayBrain.Views.ServiceBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:BayBrain.Converters">

    <UserControl.Resources>
        <conv:CategoryIconConverter      x:Key="CatIcon"/>
        <conv:UrgencyColorConverter      x:Key="UrgencyColor"/>
        <conv:NullToVisibilityConverter  x:Key="NullVis"/>
        <conv:BoolToVisibilityConverter  x:Key="BoolVis"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="28,22,28,0">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Service Catalog" Style="{StaticResource TextLarge}"/>
                    <TextBlock Text="Complete reference of all dealership services · Click any item to view full details"
                               Style="{StaticResource TextSmall}" Margin="0,4,0,0"/>
                </StackPanel>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Bottom"
                           FontSize="12" Foreground="{StaticResource TextTertiaryBrush}">
                    <Run Text="{Binding SearchResults.Count, Mode=OneWay, FallbackValue=0}"/>
                    <Run Text=" services"/>
                </TextBlock>
            </Grid>
        </Border>

        <!-- Scrollable content -->
        <ScrollViewer Grid.Row="1" Padding="28,16,28,28" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Categories}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Category section -->
                        <Border Background="{StaticResource SurfaceBrush}"
                                CornerRadius="18" Padding="22,18" Margin="0,0,0,18">
                            <StackPanel>
                                <!-- Category header -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <TextBlock Text="{Binding Converter={StaticResource CatIcon}}"
                                               FontSize="24" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="{Binding}"
                                               FontSize="18" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <Rectangle Height="1" Fill="{StaticResource SeparatorBrush}" Margin="0,0,0,14"/>

                                <!-- Services filtered by category (using custom panel via ListBox) -->
                                <ItemsControl>
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl"/>
                                    </ItemsControl.Style>
                                    <ItemsControl.ItemsSource>
                                        <Binding Path="DataContext.SearchResults"
                                                 RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                    </ItemsControl.ItemsSource>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="ServiceCard"
                                                    Background="{StaticResource CardBrush}"
                                                    CornerRadius="14" Padding="16,14"
                                                    Margin="0,0,0,10" Cursor="Hand">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick"
                                                                  Command="{Binding DataContext.SelectServiceCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  CommandParameter="{Binding}"/>
                                                </Border.InputBindings>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="90"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Left: Name + Description + Interval -->
                                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="15" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="{Binding ShortDescription}"
                                                                   FontSize="12"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                                <TextBlock Text="⏱ " FontSize="11"
                                                                           Foreground="{StaticResource TextTertiaryBrush}"/>
                                                                <TextBlock Text="{Binding Interval}"
                                                                           FontSize="11"
                                                                           Foreground="{StaticResource TextTertiaryBrush}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           MaxWidth="320"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Center: Price + Time -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                                HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding PriceRange}"
                                                                   FontSize="14" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   HorizontalAlignment="Center"/>
                                                        <TextBlock HorizontalAlignment="Center"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   Margin="0,3,0,0">
                                                            <Run Text="{Binding EstimatedMinutes}"/>
                                                            <Run Text=" min"/>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <!-- Right: Urgency pill -->
                                                    <Border Grid.Column="2"
                                                            CornerRadius="10" Padding="12,7"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Right">
                                                        <Border.Background>
                                                            <SolidColorBrush Color="#2C2C2E" Opacity="0.95"/>
                                                        </Border.Background>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="⚡ " FontSize="12"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                                            <TextBlock FontSize="13" FontWeight="Bold"
                                                                       Foreground="{StaticResource TextPrimaryBrush}">
                                                                <Run Text="{Binding BaseUrgency}"/>
                                                                <Run Text="/10" FontSize="10"
                                                                     Foreground="{StaticResource TextTertiaryBrush}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
