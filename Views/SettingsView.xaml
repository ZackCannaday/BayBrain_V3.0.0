<UserControl x:Class="BayBrain.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:BayBrain.Converters"
             Background="#1C1C1E">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <conv:HexStringToBrushConverter x:Key="HexBrush"/>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="Foreground"   Value="#636366"/>
            <Setter Property="Margin"       Value="0,0,0,8"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
        </Style>

        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Background"       Value="#3A3A3C"/>
            <Setter Property="Foreground"       Value="#FFFFFF"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Padding"          Value="10,8"/>
            <Setter Property="FontSize"         Value="14"/>
            <Setter Property="CaretBrush"       Value="#0A84FF"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background"       Value="#3A3A3C"/>
            <Setter Property="Foreground"       Value="#FFFFFF"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Padding"          Value="14,9"/>
            <Setter Property="FontSize"         Value="13"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="#0A84FF"/>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="#3A1A1A"/>
            <Setter Property="Foreground" Value="#FF453A"/>
        </Style>

        <Style x:Key="SettingCard" TargetType="Border">
            <Setter Property="Background"   Value="#2C2C2E"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding"      Value="20"/>
            <Setter Property="Margin"       Value="0,0,0,16"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,22" MaxWidth="720">

            <!-- ── Header ───────────────────────────────────────────────── -->
            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="⚙️  Settings" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Text="Customize BayBrain for your dealership" FontSize="13"
                               Foreground="#8E8E93" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="  💾  Save Settings  " Style="{StaticResource PrimaryBtn}"
                        VerticalAlignment="Center" Command="{Binding SaveCommand}"/>
            </Grid>

            <!-- Status banner -->
            <Border CornerRadius="10" Padding="14,10" Margin="0,0,0,16"
                    Visibility="{Binding ShowStatus, Converter={StaticResource BoolVis}}"
                    Background="{Binding StatusColor, Converter={StaticResource HexBrush}}"
                    Opacity="0.15">
                <TextBlock Text="{Binding StatusMessage}" FontSize="13"
                           Foreground="{Binding StatusColor, Converter={StaticResource HexBrush}}"
                           FontWeight="Medium"/>
            </Border>

            <!-- ── Dealership Info ───────────────────────────────────────── -->
            <Border Style="{StaticResource SettingCard}">
                <StackPanel>
                    <TextBlock Text="🏢  DEALERSHIP INFORMATION" Style="{StaticResource SectionLabel}"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Dealership Name" FontSize="12" Foreground="#8E8E93" Margin="0,0,0,5"/>
                            <TextBox Style="{StaticResource FieldBox}"
                                     Text="{Binding DealershipName, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Location / City" FontSize="12" Foreground="#8E8E93" Margin="0,0,0,5"/>
                            <TextBox Style="{StaticResource FieldBox}"
                                     Text="{Binding DealershipLocation, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Main Phone" FontSize="12" Foreground="#8E8E93" Margin="0,0,0,5"/>
                            <TextBox Style="{StaticResource FieldBox}"
                                     Text="{Binding DealershipPhone, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Default Advisor Signature" FontSize="12" Foreground="#8E8E93" Margin="0,0,0,5"/>
                            <TextBox Style="{StaticResource FieldBox}"
                                     Text="{Binding AdvisorSignature, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Appears at the bottom of exported scripts"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Access Model" FontSize="12" Foreground="#8E8E93" Margin="0,0,0,5"/>
                            <TextBlock Text="Settings are controlled by user roles, not advisor profile selection."
                                       TextWrapping="Wrap"
                                       Foreground="#EBEBF5"
                                       FontSize="13"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                   Text="Admin and Manager accounts can change app settings. Advisor accounts stay tied to their assigned advisor profile."
                                   TextWrapping="Wrap"
                                   Foreground="#636366"
                                   FontSize="12"
                                   VerticalAlignment="Bottom"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── Account Management ──────────────────────────────────── -->
            <Border Style="{StaticResource SettingCard}">
                <StackPanel>
                    <TextBlock Text="🔐  ACCOUNT MANAGEMENT" Style="{StaticResource SectionLabel}"/>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Username" FontSize="12" Foreground="#8E8E93" Margin="0,0,0,5"/>
                            <TextBox Style="{StaticResource FieldBox}"
                                     Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Display Name" FontSize="12" Foreground="#8E8E93" Margin="0,0,0,5"/>
                            <TextBox Style="{StaticResource FieldBox}"
                                     Text="{Binding NewDisplayName, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Role" FontSize="12" Foreground="#8E8E93" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding RoleOptions}"
                                      SelectedItem="{Binding NewUserRole}"
                                      Height="38"
                                      FontSize="13"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Linked Advisor Profile" FontSize="12" Foreground="#8E8E93" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding AdvisorProfileOptions}"
                                      SelectedItem="{Binding SelectedAdvisorForUser}"
                                      DisplayMemberPath="Name"
                                      Height="38"
                                      FontSize="13"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="PIN" FontSize="12" Foreground="#8E8E93" Margin="0,0,0,5"/>
                            <PasswordBox x:Name="NewUserPinBox"
                                         PasswordChanged="NewUserPinBox_PasswordChanged"
                                         MaxLength="12"
                                         HorizontalContentAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <Button Content="Create User"
                            Style="{StaticResource PrimaryBtn}"
                            Command="{Binding CreateUserCommand}"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,18"/>

                    <ItemsControl ItemsSource="{Binding Users}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1C1C1E" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                                <TextBlock Text="{Binding RoleLabel, StringFormat='  ·  {0}'}"
                                                           FontSize="12"
                                                           Foreground="#64D2FF"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Username, StringFormat='@{0}'}"
                                                       FontSize="12"
                                                       Foreground="#8E8E93"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="INACTIVE"
                                                       Foreground="#FF453A"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,10,0"
                                                       Visibility="{Binding IsActive, Converter={StaticResource BoolVis}, ConverterParameter=invert}"/>
                                            <Button Content="Deactivate"
                                                    Style="{StaticResource DangerBtn}"
                                                    Command="{Binding DataContext.DeactivateUserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding IsActive, Converter={StaticResource BoolVis}}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ── Behavior ─────────────────────────────────────────────── -->
            <Border Style="{StaticResource SettingCard}">
                <StackPanel>
                    <TextBlock Text="🎛️  BEHAVIOR &amp; DEFAULTS" Style="{StaticResource SectionLabel}"/>

                    <!-- Urgency threshold slider -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Minimum Urgency to Highlight" FontSize="13"
                                       Foreground="#EBEBF5" FontWeight="Medium"/>
                            <TextBlock Text="Services at or above this score are highlighted in RO Mode"
                                       FontSize="12" Foreground="#8E8E93" Margin="0,3,0,8"/>
                            <Slider Value="{Binding DefaultUrgencyThreshold}" Minimum="1" Maximum="10"
                                    IsSnapToTickEnabled="True" TickFrequency="1"
                                    Foreground="#0A84FF"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#3A3A3C" CornerRadius="8"
                                Padding="12,6" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DefaultUrgencyThreshold}" FontSize="20"
                                       FontWeight="Bold" Foreground="#0A84FF"
                                       HorizontalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <!-- Toggles -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Auto-save ROs on close" FontSize="13" Foreground="#EBEBF5"/>
                            <TextBlock Text="Automatically persist Repair Orders when you exit the RO tab"
                                       FontSize="12" Foreground="#8E8E93"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding AutoSaveROsOnClose}"
                                  VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Show mileage overdue warnings" FontSize="13" Foreground="#EBEBF5"/>
                            <TextBlock Text="Flag services that are past their recommended interval"
                                       FontSize="12" Foreground="#8E8E93"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding ShowMileageWarnings}"
                                  VerticalAlignment="Center"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Quiz sounds &amp; feedback" FontSize="13" Foreground="#EBEBF5"/>
                            <TextBlock Text="Visual and audio cues during quiz sessions"
                                       FontSize="12" Foreground="#8E8E93"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding PlayQuizSounds}"
                                  VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── Data stats ────────────────────────────────────────────── -->
            <Border Style="{StaticResource SettingCard}">
                <StackPanel>
                    <TextBlock Text="📊  DATA SUMMARY" Style="{StaticResource SectionLabel}"/>
                    <UniformGrid Columns="5">
                        <Border Background="#1C1C1E" CornerRadius="8" Padding="14,12" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="{Binding ROCount}" FontSize="24" FontWeight="Bold"
                                           Foreground="#0A84FF" HorizontalAlignment="Center"/>
                                <TextBlock Text="Repair Orders" FontSize="11" Foreground="#8E8E93"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#1C1C1E" CornerRadius="8" Padding="14,12" Margin="3,0,3,0">
                            <StackPanel>
                                <TextBlock Text="{Binding ProfileCount}" FontSize="24" FontWeight="Bold"
                                           Foreground="#30D158" HorizontalAlignment="Center"/>
                                <TextBlock Text="Advisors" FontSize="11" Foreground="#8E8E93"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#1C1C1E" CornerRadius="8" Padding="14,12" Margin="3,0,3,0">
                            <StackPanel>
                                <TextBlock Text="{Binding ServiceCount}" FontSize="24" FontWeight="Bold"
                                           Foreground="#FFD60A" HorizontalAlignment="Center"/>
                                <TextBlock Text="Services" FontSize="11" Foreground="#8E8E93"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#1C1C1E" CornerRadius="8" Padding="14,12" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding QuizCount}" FontSize="24" FontWeight="Bold"
                                           Foreground="#BF5AF2" HorizontalAlignment="Center"/>
                                <TextBlock Text="Quiz Questions" FontSize="11" Foreground="#8E8E93"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#1C1C1E" CornerRadius="8" Padding="14,12" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding UserCount}" FontSize="24" FontWeight="Bold"
                                           Foreground="#64D2FF" HorizontalAlignment="Center"/>
                                <TextBlock Text="Users" FontSize="11" Foreground="#8E8E93"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- ── Export folder ────────────────────────────────────────── -->
            <Border Style="{StaticResource SettingCard}">
                <StackPanel>
                    <TextBlock Text="📁  EXPORT FOLDER" Style="{StaticResource SectionLabel}"/>
                    <TextBlock Text="Default location for HTML script exports and data exports"
                               FontSize="12" Foreground="#8E8E93" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#3A3A3C" CornerRadius="8" Padding="10,8">
                            <TextBlock Text="{Binding ExportFolder}" FontSize="13"
                                       Foreground="#EBEBF5" TextTrimming="CharacterEllipsis"/>
                        </Border>
                        <Button Grid.Column="1" Content="Browse…" Style="{StaticResource ActionBtn}"
                                Margin="10,0,0,0" Command="{Binding BrowseExportFolderCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── Data management ──────────────────────────────────────── -->
            <Border Style="{StaticResource SettingCard}">
                <StackPanel>
                    <TextBlock Text="💾  DATA MANAGEMENT" Style="{StaticResource SectionLabel}"/>
                    <TextBlock Text="Export or import all BayBrain data as a ZIP archive containing JSON files."
                               FontSize="12" Foreground="#8E8E93" Margin="0,0,0,14"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Button Content="⬆️  Export All Data" Style="{StaticResource ActionBtn}"
                                Margin="0,0,10,0" Command="{Binding ExportAllDataCommand}"/>
                        <Button Content="⬇️  Import Data" Style="{StaticResource ActionBtn}"
                                Command="{Binding ImportDataCommand}"/>
                    </StackPanel>

                    <Separator Background="#3A3A3C" Margin="0,0,0,16"/>

                    <TextBlock Text="DANGER ZONE" FontSize="11" Foreground="#FF453A" FontWeight="SemiBold"
                               Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="🗑  Clear RO History" Style="{StaticResource DangerBtn}"
                                Margin="0,0,10,0" Command="{Binding ClearROHistoryCommand}"
                                ToolTip="Deletes all saved repair orders — cannot be undone"/>
                        <Button Content="🗑  Clear Advisor Profiles" Style="{StaticResource DangerBtn}"
                                Margin="0,0,10,0" Command="{Binding ClearProfilesCommand}"
                                ToolTip="Deletes all advisor profiles and quiz history"/>
                        <Button Content="↺  Reset to Defaults" Style="{StaticResource ActionBtn}"
                                Command="{Binding ResetToDefaultsCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ── About ────────────────────────────────────────────────── -->
            <Border Background="#2C2C2E" CornerRadius="12" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="52" Height="52" CornerRadius="12"
                            Background="#0A84FF" Margin="0,0,16,0">
                        <TextBlock Text="🧠" FontSize="26" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="BayBrain" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock FontSize="13" Foreground="#8E8E93">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="Version {0}  ·  {1}">
                                    <Binding Path="AppVersion"/>
                                    <Binding Path="BuildDate"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock Text="Automotive Service Advisor Intelligence Platform"
                                   FontSize="12" Foreground="#636366" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="Built with .NET 8 + WPF" FontSize="12"
                                   Foreground="#636366" HorizontalAlignment="Right"/>
                        <TextBlock Text="CommunityToolkit.Mvvm" FontSize="11"
                                   Foreground="#48484A" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="© 2026 BayBrain. For dealership use only." FontSize="11"
                       Foreground="#48484A" HorizontalAlignment="Center" Margin="0,16,0,28"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
