<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>BayBrain</AssemblyName>
    <RootNamespace>BayBrain</RootNamespace>
    <Version>3.0.0</Version>
    <Authors>BayBrain Team</Authors>
    <Description>Automotive Service Advisor Intelligence Platform — Phase 3</Description>
    <UseWindowsForms>false</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="System.Text.Json" Version="10.0.8" />
  </ItemGroup>

  <!-- JSON data files: copied to output directory so DataLoaderService finds them at runtime.
       Edit these files directly — no recompile needed. -->
  <ItemGroup>
    <Content Include="Data\services.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\quiz.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
